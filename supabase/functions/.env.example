# Edge Function settings. Copy to supabase/functions/.env.local for local runs;
# set the production values with `supabase secrets set` (see docs/DEPLOYMENT.md).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the platform.

# Organization (agency) that receives public website inquiries, by slug.
INTAKE_ORGANIZATION_SLUG=nest-health-staff-dev

# Random secret (32+ characters) used to hash client IPs for rate limiting.
INTAKE_IP_HASH_SECRET=replace-with-a-long-random-string

# Comma-separated browser origins allowed to call the intake endpoint.
# Defaults to PUBLIC_SITE_URL and its www. host when unset.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Portal origins used in email links.
PUBLIC_SITE_URL=http://127.0.0.1:3000
CLINICIAN_PORTAL_URL=http://127.0.0.1:3001
FACILITY_PORTAL_URL=http://127.0.0.1:3002
ADMIN_PORTAL_URL=http://127.0.0.1:3003

# Shared secret the scheduler sends as x-outbox-secret (32+ characters).
OUTBOX_PROCESSOR_SECRET=replace-with-another-long-random-string

# Email delivery: "dev" logs instead of sending. "resend" needs the two values below.
EMAIL_PROVIDER=dev
# RESEND_API_KEY=
# EMAIL_FROM=Nest Health Staff <hello@notifications.nesthealthstaff.com>
